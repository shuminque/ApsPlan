<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.depository_manage.mapper.aps.ProductionPlanItemMapper">

    <resultMap id="ProductionPlanItemResultMap" type="com.depository_manage.entity.aps.ProductionPlanItem">
        <id column="id" property="id"/>
        <result column="plan_id" property="planId"/>
        <result column="plan_batch_no" property="planBatchNo"/>
        <result column="order_id" property="orderId"/>
        <result column="customer" property="customer"/>
        <result column="model" property="model"/>
        <result column="outer_inner_ring" property="outerInnerRing"/>
        <result column="line_id" property="lineId"/>
        <result column="line_name" property="lineName"/>
        <result column="start_date" property="startDate"/>
        <result column="end_date" property="endDate"/>
        <result column="assign_qty" property="assignQty"/>
        <result column="source" property="source"/>
        <result column="create_time" property="createdAt"/>
        <result column="update_time" property="updatedAt"/>
    </resultMap>

    <resultMap id="PlanCalendarEventResultMap" type="com.depository_manage.pojo.shift.CalendarEventDTO">
        <id column="id" property="id"/>
        <result column="title" property="title"/>
        <result column="start" property="start"/>
        <result column="end" property="end"/>
        <result column="startTime" property="shiftStartTime"/>
        <result column="endTime" property="shiftEndTime"/>
        <result column="color" property="color"/>
        <result column="eventType" property="eventType"/>
        <result column="source" property="source"/>
    </resultMap>

    <select id="selectPlanCalendarEvents" resultMap="PlanCalendarEventResultMap">
        SELECT
            ppi.id,
            CONCAT('[计划] ',
                   IFNULL(ppi.line_name, '产线'),
                   ' ',
                   IFNULL(ppi.customer, ''),
                   '/',
                   IFNULL(ppi.outer_inner_ring, ''),
                   ' ',
                   IFNULL(ppi.model, ''),
                   ' x ',
                   FORMAT(IFNULL(ppi.assign_qty, 0), 0)) AS title,
            DATE_FORMAT(ppi.start_date, '%Y-%m-%dT%H:%i:%s') AS start,
            DATE_FORMAT(ppi.end_date, '%Y-%m-%dT%H:%i:%s') AS end,
            DATE_FORMAT(ppi.start_date, '%H:%i:%s') AS startTime,
            DATE_FORMAT(ppi.end_date, '%H:%i:%s') AS endTime,
            '#9B59B6' AS color,
            'PLAN' AS eventType,
            IFNULL(ppi.source, 'PRODUCTION_PLAN_ITEM') AS source
        FROM production_plan_item ppi
        WHERE ppi.start_date &lt;= #{endDate}
          AND ppi.end_date &gt;= #{startDate}
        ORDER BY ppi.start_date, ppi.id
    </select>

</mapper>
